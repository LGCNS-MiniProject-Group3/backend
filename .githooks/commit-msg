#!/bin/sh
# 커밋 메시지 첫 줄이 팀 규칙에 맞는지 검사한다. 규칙: docs/CONTRIBUTING.md
#   <타입>(<범위>): <제목>    예) feat(gateway): JWT 검사 후 X-User-Id 헤더 전달
#   임시 저장은 wip: ...      (Squash and merge로 합쳐진다)

msg=$(head -n 1 "$1")

# 병합·되돌리기 커밋은 깃이 만드는 문구라 검사하지 않는다
case "$msg" in
  "Merge "*|"Revert "*) exit 0 ;;
esac

types='feat|fix|refactor|test|docs|style|chore|ci'
scopes='gateway|discovery|config|user|content|collector|guide|bookmark|common|kafka|infra|ci|docs'
pattern="^($types)(\(($scopes)\))?!?: .+|^wip: .+"

if ! echo "$msg" | grep -Eq "$pattern"; then
  echo ""
  echo "  커밋 메시지 형식이 맞지 않습니다."
  echo "  받은 것 : $msg"
  echo ""
  echo "  형식    : <타입>(<범위>): <제목>"
  echo "  타입    : feat fix refactor test docs style chore ci"
  echo "  범위    : gateway discovery config user content collector guide bookmark"
  echo "            common kafka infra ci docs"
  echo "  예      : feat(gateway): JWT 검사 후 X-User-Id 헤더 전달"
  echo ""
  echo "  자세한 규칙은 docs/CONTRIBUTING.md 를 보세요."
  echo ""
  exit 1
fi

