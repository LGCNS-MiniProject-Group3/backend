# 실행 환경 변수. 이 파일을 .env 로 복사해 값을 채운다. .env 는 커밋하지 않는다.
# 서비스 설정(DB, 키, 주소)은 여기가 아니라 private 설정 저장소에 있다 (docs/design.md 9장).
# 값은 팀 채널 같은 비공개 경로로만 주고받는다.

# --- Config Server가 읽는 값 ---
# 설정 저장소의 '{cipher}…' 값을 풀 때 쓰는 키 (1번이 전달)
ENCRYPT_KEY=
# 설정 저장소 주소와 읽기 전용 토큰 (토큰은 1번이 전달)
CONFIG_REPO_URI=https://github.com/LGCNS-MiniProject-Group3/config.git
CONFIG_REPO_TOKEN=

# --- 서비스가 읽는 값 ---
# 실행 프로필: local(IDE 실행) / dev(compose 전체) / prod(EC2)
SPRING_PROFILES_ACTIVE=local
# Config Server 주소. 비우면 http://localhost:8888 (compose에서는 http://config:8888)
CONFIG_URL=
# collector 파일 적재(/import)가 읽는 폴더. 쓰지 않으면 비워 둔다
COLLECT_DATA_DIR=

# --- 로컬 MariaDB 컨테이너 (local·dev) ---
# root 비밀번호. 각자 정한다
MARIADB_ROOT_PASSWORD=
